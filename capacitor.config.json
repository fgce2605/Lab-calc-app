{
  "appId": "com.labcalc.qc",
  "appName": "LabCalc Pro",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#0284c7",
      "sound": "beep.wav"
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
